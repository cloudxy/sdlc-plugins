.DS_Store
.idea/
.vscode/
.cursor/
.windsurf/
__pycache__/
*.pyc
.venv/

# Generated project-local references to this checkout. Recreate with the link scripts.
/.codex/skills/
/.codex/agents/
/.kimi-code/skills/
/.kimi-code/agents/

# Local personal host/IDE/workspace overrides & runtime state (never commit)
/.claude/
/.video_agent/
/.sdlc/
/sdlc.config.yaml
/AGENTS.override.md
.env
.env.*
*.log
*.db
*.sqlite
*.sqlite3
*.bak

# Private maintainer thought chains, evaluation archives, rejection logs & local privacy dropbox
/maintainers/archive/
/maintainers/out-of-scope/
/maintainers/method-changes/
/maintainers/private/
/private/
/skills/sdlc-eval/regressions/*.json

# vendor：仓库不分发任何上游内容，只提交安装脚本、说明和锁文件；使用者运行 bash vendor/install.sh 从源头下载
vendor/*
!vendor/install.sh
!vendor/README.md
!vendor/*.lock.json

# Grok 订阅授权凭据只存 ~/.sdlc/grok/，任何情况下不进仓库
credentials.json
*.credentials.json
